<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/main.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"/>

    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>

    <title>Portfolio</title>
</head>

<body>

    <div class="frame">

        <div class="main_frame">

            <!-- ========== CHAP TARAF ========== -->
            <div class="left_frame">
                <div class="left_1">
                    <div class="left_1-1">
                        <img src="images/profile picture.png"
                        width="156px"
                        height="142px"
                        alt=""/>
                    </div>
                    <div class="left_1-2"><%=user.name%></div>
                    <div class="left_1-3"><%=user.profession%></div>
                    <div class="left_icons">
                        <a class="link_href" href="">
                          <div class="icon">
                            <img src="/icon/Icons-facebook.png" class="icon-1" />
                          </div>
                        </a>
                        <a class="link_href" href="">
                          <div class="icon">
                            <img src="/icon/Icons-instagram.png" class="icon-1" />
                          </div>
                        </a>
                        <a class="link_href" href="">
                          <div class="icon">
                            <img src="/icon/Icons-linkedin.png" class="icon-1" />
                          </div>
                        </a>
                        <a class="link_href" href="">
                          <div class="icon">
                            <img src="/icon/Icons-twitter.png" class="icon-1" />
                          </div>
                        </a>
                        <a class="link_href" href="">
                          <div class="icon">
                            <img src="/icon/Icons-dribbble.png" class="icon-1" />
                          </div>
                        </a>
                    </div>
                </div>
                <div class="marginer"></div>

                <!-- Age, Residence, Freelance, Address -->
                <div class="left_2">
                    <div class="info_row">
                        <span class="info_label">Age:</span>
                        <span class="info_value">24</span>
                    </div>
                    <div class="info_row">
                        <span class="info_label">Residence:</span>
                        <span class="info_value">BD</span>
                    </div>
                    <div class="info_row">
                        <span class="info_label">Freelance:</span>
                        <span class="info_value info_green">Available</span>
                    </div>
                    <div class="info_row">
                        <span class="info_label">Address:</span>
                        <span class="info_value">Dhaka,Bangladesh</span>
                    </div>
                </div>

                <div class="marginer"></div>

                <!-- Languages -->
                <div class="left_3">
                    <div class="section_title">Languages</div>

                    <div class="lang_row">
                        <span class="lang_name">Bangla</span>
                        <span class="lang_percent">100%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 100%;"></div>
                    </div>

                    <div class="lang_row">
                        <span class="lang_name">English</span>
                        <span class="lang_percent">80%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 80%;"></div>
                    </div>

                    <div class="lang_row">
                        <span class="lang_name">Spanish</span>
                        <span class="lang_percent">60%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 60%;"></div>
                    </div>
                </div>

                <div class="marginer"></div>

                <!-- Skills -->
                <div class="left_4">
                    <div class="section_title">Skills</div>

                    <div class="lang_row">
                        <span class="lang_name">Html</span>
                        <span class="lang_percent">90%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 90%;"></div>
                    </div>

                    <div class="lang_row">
                        <span class="lang_name">CSS</span>
                        <span class="lang_percent">85%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 85%;"></div>
                    </div>

                    <div class="lang_row">
                        <span class="lang_name">Js</span>
                        <span class="lang_percent">80%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 80%;"></div>
                    </div>

                    <div class="lang_row">
                        <span class="lang_name">PHP</span>
                        <span class="lang_percent">75%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 75%;"></div>
                    </div>

                    <div class="lang_row">
                        <span class="lang_name">WordPress</span>
                        <span class="lang_percent">85%</span>
                    </div>
                    <div class="bar_bg">
                        <div class="bar_fill" style="width: 85%;"></div>
                    </div>
                </div>

                <div class="marginer"></div>

                <!-- Extra Skills -->
                <div class="left_5">
                    <div class="section_title">Extra Skills</div>

                    <div class="extra_row">
                        <img src="/icon/Icons.png" class="extra_icon" alt="">
                        <span>Bootstrap, Materialize</span>
                    </div>
                    <div class="extra_row">
                        <img src="/icon/Icons.png" class="extra_icon" alt="">
                        <span>Stylus, Sass, Less</span>
                    </div>
                    <div class="extra_row">
                        <img src="/icon/Icons.png" class="extra_icon" alt="">
                        <span>Gulp, Webpack, Grunt</span>
                    </div>
                    <div class="extra_row">
                        <img src="/icon/Icons.png" class="extra_icon" alt="">
                        <span>GIT Knowledge</span>
                    </div>
                </div>

                <div class="marginer"></div>
            </div>

            <!-- ========== O'RTA TARAF ========== -->
            <div class="midd_frame">

                <!-- Doctor neurologists..." -->
                <div class="midd_top">
                    <div class="midd_top-left">
                        <h1>Doctor neurologists <br> in OHSU Hospital</h1>
                        <p>
                            Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing
                            Elit. Et, Volutpat Feugiat Placerat Lobortis. Natoque
                            Rutrum Semper Sed Suspendisse Nunc Lectus.
                        </p>
                        <button class="hire_btn">HIRE ME &rarr;</button>
                    </div>
                    <div class="midd_top-right">
                        <img src="/icon/Your Image 1.png" alt="">
                    </div>
                </div>

                <!--  "My Services" -->
                <div class="midd_bottom">
                    <h2>My Services</h2>
                    <p>
                        Amet Minim Mollit Non Deserunt Ullamco Est Sit Aliqua Dolor
                        Do Amet Sint. Velit Officia Consequat Duis Enim Velit Mollit.
                        Lorem Ipsum
                    </p>

                    <div class="services_grid">
                        <div class="service_card">
                            <img src="/icon/coding.png" alt="">
                            <h3>Web Development</h3>
                            <p>Blog, E-Commerce</p>
                        </div>
                        <div class="service_card">
                            <img src="/icon/illustration.png" alt="">
                            <h3>UI/UX Design</h3>
                            <p>Mobile App, Website Design</p>
                        </div>
                        <div class="service_card">
                            <img src="/icon/Icons_Microphone.png" alt="">
                            <h3>Sound Design</h3>
                            <p>Voice Over, Beat Making</p>
                        </div>
                        <div class="service_card">
                            <img src="/icon/game-development.png" alt="">
                            <h3>Game Design</h3>
                            <p>Character Design, Props &amp; Objects</p>
                        </div>
                        <div class="service_card">
                            <img src="/icon/Photographer.png" alt="">
                            <h3>Photography</h3>
                            <p>Portrait, Product Photography</p>
                        </div>
                        <div class="service_card">
                            <h3>Advertising</h3>
                            <p>Lorem Ipsum Dolor Sit Amet, Consectetur Adipiscing Elit.</p>
                            <a href="#" class="order_link">ORDER NOW &gt;</a>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ======== O'NG TARAF ======== -->
            <div class="right_frame">
                <div class="right_icon right_icon-active">
                    <img src="/icon/Home.png" alt="">
                </div>
                <div class="right_icon">
                    <img src="/icon/Service.png" alt="">
                </div>
                <div class="right_icon">
                    <img src="/icon/Cv.png" alt="">
                </div>
                <div class="right_icon">
                    <img src="/icon/Portfolio.png" alt="">
                </div>
                 <div class="right_icon">
                    <img src="/icon/Blog.png" alt="">
                </div>
                <div class="right_icon">
                    <img src="/icon/Contact.png" alt="">
                </div>
            </div>

        </div>

    </div>

</body>
</html>
