<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>REJA</title>

    <!-- Bootstrap -->
    <link
        rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
        integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm41YMj70gZWKYbI706t3"
        crossorigin="anonymous"
    >
</head>

<body style="background-color: #b8bbd1;">

    <div class="container">

        <!-- Title -->
        <h1 class="display-4 text-center py-4">
            REJA VA MAQSADLAR
        </h1>

        <!-- Create item -->
        <div class="jumbotron p-4 shadow-sm">

            <form
                id="create-form"
                action="/create-item"
                method="POST"
            >

                <div class="d-flex align-items-center">

                    <input
                        id="create-field"
                        name="item"
                        autofocus
                        autocomplete="off"
                        class="form-control mr-3"
                        type="text"
                        placeholder="Yangi reja yozing..."
                        style="flex: 1;"
                    >

                    <button
                        class="btn btn-primary"
                        type="submit"
                        style="border-radius: 20px;"
                    >
                        Yangi reja qo‘shish
                    </button>

                </div>

            </form>

        </div>

    </div>

</body>
</html>