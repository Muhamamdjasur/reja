<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>REJA</title>

    <!-- Bootstrap -->
    <link
        rel="stylesheet"
        href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
        integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm41YMj70gZWKYbI706t3"
        crossorigin="anonymous"
    >
</head>

<body style="background-color: #b8bbd1;">

    <div class="container">

        <!-- Title -->
        <h1 class="display-4 text-center py-4">
            REJA VA MAQSADLAR
        </h1>

        <!-- Create item -->
        <div class="jumbotron p-4 shadow-sm">

            <form
                id="create-form"
                action="/create-item"
                method="POST"
            >

                <div class="d-flex align-items-center">

                    <input
                        id="create-field"
                        name="reja"
                        autofocus
                        autocomplete="off"
                        class="form-control mr-3"
                        type="text"
                        placeholder="Yangi reja yozing..."
                        style="flex: 1;"
                    >

                    <button
                        class="btn btn-primary"
                        type="submit"
                        style="border-radius: 20px;"
                    >
                        Yangi Reja Qo‘shish
                    </button>

                </div>

            </form>

        </div>

        

       <ul id="item-list" class="list-group pb-5">

    <% items.map(function(item) { %>

        <li
            class="list-group-item list-group-item-info d-flex align-items-center justify-content-between"
        >
            <span class="item-text">
                <%= item.reja %>
            </span>

            <div>
                <button
                    data-id="<%= item._id %>"
                    class="edit-me btn btn-secondary btn-sm mr-1"
                >
                    O'zgartirish
                </button>

                <button
                    data-id="<%= item._id %>"
                    class="delete-me btn btn-danger btn-sm"
                >
                    O'chirish
                </button>
            </div>
        </li>

    <% }) %>

</ul>

<button
    id="clean-all"
    class="btn btn-danger"
    style="border-radius: 10px;"
>
    Clean All Plans
</button>